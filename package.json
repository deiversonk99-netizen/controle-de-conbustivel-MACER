{
  "name": "macer-combustivel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/service-worker.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-macer \"node scripts/e2e.mjs\"",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-macer \"node scripts/verify.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-macer \"node --test tests/rules/*.test.mjs\""
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.31.0",
    "prettier": "^3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
